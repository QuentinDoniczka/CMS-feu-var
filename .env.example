# Copier ce fichier vers .env avant de démarrer la stack locale (`cp .env.example .env`
# ou automatiquement fait par docker/up.sh). Identifiants de développement local
# uniquement — jamais de secret réel ici, jamais de .env commité.

# --- Base de données ---
DB_NAME=massifs
DB_USER=massifs
DB_PASSWORD=massifs_local_dev
DB_ROOT_PASSWORD=massifs_root_local_dev

# --- WordPress : compte administrateur local ---
WP_TITLE=MASSIFS — Accès du jour aux massifs forestiers (local)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_local_dev
WP_ADMIN_EMAIL=admin@massifs.local

# --- Compte gestionnaire de démonstration (fixture, rôle restreint) ---
WP_MANAGER_USER=gestionnaire-demo
WP_MANAGER_PASSWORD=gestionnaire_local_dev
WP_MANAGER_EMAIL=gestionnaire@massifs.local

# --- Ports exposés sur l'hôte ---
# WORDPRESS_PORT est aussi l'adresse canonique du site (siteurl/home,
# provisionnés sur http://localhost:<ce port>) — voir docker/README.md,
# section « Changer de port ».
WORDPRESS_PORT=3002
TILES_PORT=8081
DB_PORT=3306
